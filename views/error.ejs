<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SecureTasker — Error</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a href="/" class="logo">🔒 SecureTasker</a>
    <div class="nav-links">
      <% if (typeof user !== 'undefined' && user) { %>
        <span class="nav-user">👤 <%= user.username %></span>
        <a href="/tasks" class="nav-link">Tasks</a>
        <a href="/logout" class="nav-link">Logout</a>
      <% } else { %>
        <a href="/login" class="nav-link">Login</a>
      <% } %>
    </div>
  </nav>

  <main class="container">
    <div class="card" style="text-align:center; padding:3rem 2rem;">
      <h1 style="font-size:2.5rem; margin-bottom:.5rem;">⚠️</h1>
      <h2 style="color:var(--accent); margin-bottom:1rem;">Something went wrong</h2>
      <!-- Vulnerability #6 (CWE-209): the error variable may contain a full stack trace
           when rendered by the vulnerable error handler in server.js -->
      <div class="output-box" style="text-align:left;"><%= error %></div>
      <a href="/tasks" class="btn btn-secondary mt-3">← Go Home</a>
    </div>
  </main>
</body>
</html>
